# Exemple de configuration de `malaga serve` par variables d'environnement.
# Copier en `.env` (ignoré par git) puis : set -a; . ./.env; set +a; malaga serve
# Les options de ligne de commande équivalentes ont priorité. Aucun secret n'est nécessaire.
MALAGA_MODEL=models/gguf/nllb-200-distilled-600M-q4_k_m.gguf
MALAGA_DEVICE=auto
MALAGA_HOST=127.0.0.1
MALAGA_PORT=8080
# Budget VRAM des graphes CUDA (Mo)
MALAGA_GRAPH_CACHE_MB=512
# MALAGA_NO_CUDA_GRAPH=1
# MALAGA_LAZY_EMBEDDINGS=1   # seulement avec --fast-vocab
RUST_LOG=info
